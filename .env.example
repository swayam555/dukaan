# Copy to .env next to docker-compose.yml. Never commit .env.
# Dukaan has no AI and needs no paid keys. Both values are optional.

# Signs sync/dashboard JWTs. Change it for anything beyond your laptop (≥ 32 chars).
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# true = the OTP is returned in the API response instead of sent by SMS (dev only).
DEV_OTP=true
