{
  "expo": {
    "name": "Dukaan",
    "slug": "dukaan",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dukaan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "in.dukaan.pos",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Dukaan uses the camera to scan product barcodes while billing.",
        "NSBluetoothAlwaysUsageDescription": "Dukaan connects to your Bluetooth receipt printer to print bills.",
        "NSFaceIDUsageDescription": "Unlock Dukaan with Face ID instead of your PIN."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDEBD8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.dukaan.pos",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F4F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-background-task",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Dukaan with Face ID instead of your PIN."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": false
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}