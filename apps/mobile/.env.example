# Copy to apps/mobile/.env. EXPO_PUBLIC_* values are baked into the app bundle: no secrets here.
# The app works fully offline without a sync server; this is only used for Settings → Cloud sync.
# Android emulator → host is 10.0.2.2 (with `adb reverse tcp:4780 tcp:4780`, localhost works too).
EXPO_PUBLIC_SYNC_URL=http://10.0.2.2:4780
# Optional crash reporting.
EXPO_PUBLIC_SENTRY_DSN=
