{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["dukaan"],
  "ios": { "iosModuleName": "DukaanNative" },
  "android": { "androidNamespace": ["dukaan"], "androidCxxLibName": "DukaanNative" },
  "autolinking": {
    "BluetoothPrinter": {
      "ios": { "language": "swift", "implementationClassName": "HybridBluetoothPrinter" },
      "android": { "language": "kotlin", "implementationClassName": "HybridBluetoothPrinter" }
    },
    "HidScanner": {
      "ios": { "language": "swift", "implementationClassName": "HybridHidScanner" },
      "android": { "language": "kotlin", "implementationClassName": "HybridHidScanner" }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
